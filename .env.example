# VPS hostname pointing at your server. The free static app needs no environment file.
SAYBOARD_DOMAIN=boards.example.org
# Enable operator-provisioned username/password accounts when ready.
SAYBOARD_AUTH_ENABLED=0
SAYBOARD_SIGNUP_ENABLED=0
# username preserves recovery-kit signup. verified-email requires SMTP.
SAYBOARD_TEACHER_ACCOUNT_MODE=username
SAYBOARD_PUBLIC_ACCOUNT_LIMIT=100
# Optional Google teacher sign-in. Keep the secret on the server only.
SAYBOARD_GOOGLE_CLIENT_ID=
SAYBOARD_GOOGLE_CLIENT_SECRET=
# Set to 1 only when ready to allow new Google users to create teacher accounts.
SAYBOARD_GOOGLE_SIGNUP_ENABLED=0

# Optional standard SMTP for invitations and verified-email accounts.
SAYBOARD_SMTP_HOST=
SAYBOARD_SMTP_PORT=587
SAYBOARD_SMTP_USER=
SAYBOARD_SMTP_PASSWORD=
SAYBOARD_EMAIL_FROM=
SAYBOARD_EMAIL_REPLY_TO=
