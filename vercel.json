{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/teacher",
      "has": [
        {
          "type": "host",
          "value": "sayboard.org"
        }
      ],
      "destination": "https://classroom.sayboard.org/teacher",
      "permanent": true
    },
    {
      "source": "/teacher",
      "has": [
        {
          "type": "host",
          "value": "sayboard.vercel.app"
        }
      ],
      "destination": "https://classroom.sayboard.org/teacher",
      "permanent": true
    },
    {
      "source": "/teacher.html",
      "has": [
        {
          "type": "host",
          "value": "sayboard.org"
        }
      ],
      "destination": "https://classroom.sayboard.org/teacher",
      "permanent": true
    },
    {
      "source": "/teacher.html",
      "has": [
        {
          "type": "host",
          "value": "sayboard.vercel.app"
        }
      ],
      "destination": "https://classroom.sayboard.org/teacher",
      "permanent": true
    },
    {
      "source": "/teacher.html",
      "destination": "/teacher",
      "permanent": true
    },
    {
      "source": "/teacher/",
      "destination": "/teacher",
      "permanent": true
    },
    {
      "source": "/:path((?!source(?:/|$)|assets(?:/|$)|move-board\\.html$).*)",
      "has": [
        {
          "type": "host",
          "value": "sayboard.vercel.app"
        }
      ],
      "destination": "https://sayboard.org/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/teacher",
      "destination": "/teacher.html"
    }
  ]
}
